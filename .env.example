# Copy to .env and choose your own values. .env is git-ignored.

# Used by both PostgreSQL containers (demo inventory DB and TraceOps' own DB)
POSTGRES_USER=traceops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=inventory

# Optional AI explanations. "none" (default) or "ollama" (free, runs locally).
EXPLAIN_PROVIDER=none
# OLLAMA_URL=http://host.docker.internal:11434
# OLLAMA_MODEL=llama3.2
